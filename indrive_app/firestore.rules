rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    // role e isVerified solo los escribe la Cloud Function (Admin SDK),
    // que no pasa por estas reglas. El cliente puede crear su doc inicial
    // pero nunca fijar esos dos campos por su cuenta. Los tres (role,
    // isVerified, isActive) usan .get(key, default) en vez de acceso
    // directo: un acceso directo a una clave ausente rompe la regla para
    // *todas* las demas escrituras del dueño, no solo esta — y con el
    // registro nuevo (nombre/nick se guardan ANTES de que la Cloud
    // Function assignInitialRole fije role/isVerified) hay una ventana
    // real donde el doc todavia no tiene esos campos. Bug real: esto
    // rompia guardarCedulaUrl con permission-denied cuando la escritura
    // caia en esa ventana.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) &&
        !("role" in request.resource.data) &&
        !("isVerified" in request.resource.data);
      allow update: if isOwner(uid) &&
        request.resource.data.get('role', null) == resource.data.get('role', null) &&
        request.resource.data.get('isVerified', null) == resource.data.get('isVerified', null) &&
        request.resource.data.get('isActive', true) == resource.data.get('isActive', true);
      allow delete: if false;
    }

    // Copia pública de nombre/nick/avatar (sprint extra de identidad):
    // users/{uid} tiene cedulaUrl y phoneNumber, sensibles, por eso su
    // lectura es solo del dueño/admin. Esta colección aparte solo tiene
    // estos 3 campos, sin nada sensible, así que cualquier usuario
    // autenticado puede leerla — así el Cliente ve quién es su repartidor
    // asignado y viceversa sin exponer el resto del perfil.
    match /perfiles_publicos/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['nombre', 'apellido', 'nick', 'avatarId']);
      allow delete: if false;
    }

    // Posición aproximada de repartidores "disponibles" (sprint extra:
    // mapa en el Home de Cliente) — colección aparte de users/{uid} a
    // propósito, mismo criterio que perfiles_publicos/: solo posición +
    // tipo de vehículo, nada de teléfono/nombre/documentos, para que
    // cualquier Cliente autenticado pueda verla sin exponer el resto del
    // perfil del repartidor. El propio repartidor la escribe al
    // prender/apagar el switch de disponibilidad; se borra al apagarlo.
    match /repartidores_disponibles/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['posicion', 'tipoVehiculo', 'updatedAt']);
      allow delete: if isOwner(uid);
    }

    function isVerifiedRepartidor() {
      return isSignedIn() &&
        request.auth.token.role == 'repartidor' &&
        request.auth.token.isVerified == true;
    }

    function isCliente() {
      return isSignedIn() && request.auth.token.role == 'cliente';
    }

    // Sprint 10: antes solo el repartidor necesitaba isVerified para
    // operar (aceptar/ofertar) — el cliente podía publicar envíos sin
    // ninguna revisión previa, dejando la puerta abierta a que cualquiera
    // sature el sistema con envíos falsos. Ahora ambos roles requieren
    // aprobación de un Admin antes de poder usar la app de verdad.
    function isVerifiedCliente() {
      return isCliente() && request.auth.token.isVerified == true;
    }

    // Sprint 6.1: el repartidor fija metodoPago (y comprobanteUrl si es QR)
    // en la misma escritura que entregado. pagoVerificado no puede venir
    // en esta escritura — solo un Admin lo fija despues (ver mas abajo).
    function pagoValidoAlEntregar() {
      return request.resource.data.metodoPago in ['efectivo', 'qr'] &&
        !("pagoVerificado" in request.resource.data) &&
        (request.resource.data.metodoPago == 'efectivo' ||
          request.resource.data.comprobanteUrl is string);
    }

    // Compara el código que el repartidor dice haber recibido del cliente
    // contra el valor real guardado en el subdocumento privado (Sprint
    // 8.2) — el repartidor nunca lee `codigoEntrega` directo, solo esta
    // regla lo compara server-side.
    function codigoEntregaValido(envioId) {
      return request.resource.data.codigoIngresado ==
        get(/databases/$(database)/documents/envios/$(envioId)/privado/entrega).data.codigoEntrega;
    }

    function envioCamposFijosSinCambio() {
      return request.resource.data.clienteId == resource.data.clienteId &&
        request.resource.data.descripcion == resource.data.descripcion &&
        request.resource.data.origen == resource.data.origen &&
        request.resource.data.origenGeohash == resource.data.origenGeohash &&
        request.resource.data.destino == resource.data.destino &&
        request.resource.data.montoOfertadoInicialCentavos ==
          resource.data.montoOfertadoInicialCentavos;
    }

    // expiraEn lo fija la Cloud Function setEnvioExpiration via Admin SDK,
    // que no pasa por estas reglas. El cliente nunca lo escribe.
    match /envios/{envioId} {
      allow read: if isSignedIn();

      allow create: if isVerifiedCliente() &&
        request.auth.uid == request.resource.data.clienteId &&
        request.resource.data.status == 'pendiente_ofertas' &&
        request.resource.data.repartidorAsignadoId == null &&
        request.resource.data.ofertaAceptadaId == null &&
        request.resource.data.montoOfertadoInicialCentavos is int &&
        request.resource.data.montoOfertadoInicialCentavos > 0 &&
        request.resource.data.categoria in
          ['documentos', 'paquete_chico', 'paquete_mediano', 'encomienda_mercado'] &&
        !("expiraEn" in request.resource.data);

      // El cliente dueño puede cancelar mientras siga pendiente.
      allow update: if isSignedIn() &&
        resource.data.clienteId == request.auth.uid &&
        resource.data.status == 'pendiente_ofertas' &&
        request.resource.data.status == 'cancelado' &&
        request.resource.data.repartidorAsignadoId == resource.data.repartidorAsignadoId &&
        request.resource.data.ofertaAceptadaId == resource.data.ofertaAceptadaId &&
        envioCamposFijosSinCambio();

      // Un repartidor verificado toma un envío pendiente. La transacción
      // atómica del cliente (EnviosRepository.aceptarEnvioDirecto) más esta
      // misma precondición evaluada sobre los datos leídos en la
      // transacción es lo que previene la doble asignación.
      allow update: if isVerifiedRepartidor() &&
        resource.data.status == 'pendiente_ofertas' &&
        resource.data.repartidorAsignadoId == null &&
        request.resource.data.status == 'asignado' &&
        request.resource.data.repartidorAsignadoId == request.auth.uid &&
        request.resource.data.ofertaAceptadaId == resource.data.ofertaAceptadaId &&
        envioCamposFijosSinCambio();

      // El cliente dueño elige una propuesta específica. Se valida con
      // get() que el repartidor asignado es realmente el dueño de esa
      // oferta — evita que el cliente asigne un repartidor arbitrario.
      allow update: if isSignedIn() &&
        resource.data.clienteId == request.auth.uid &&
        resource.data.status == 'pendiente_ofertas' &&
        resource.data.repartidorAsignadoId == null &&
        request.resource.data.status == 'asignado' &&
        request.resource.data.ofertaAceptadaId != null &&
        request.resource.data.repartidorAsignadoId ==
          get(/databases/$(database)/documents/envios/$(envioId)/ofertas/$(request.resource.data.ofertaAceptadaId)).data.repartidorId &&
        envioCamposFijosSinCambio();

      // El repartidor asignado avanza el viaje: asignado→en_curso ("Iniciar
      // viaje", arranca el Foreground Service) o en_curso→entregado
      // ("Marcar como entregado", lo detiene, y fija metodoPago/
      // comprobanteUrl — Sprint 6.1). Ningún otro campo cambia.
      allow update: if isSignedIn() &&
        resource.data.repartidorAsignadoId == request.auth.uid &&
        ((resource.data.status == 'asignado' && request.resource.data.status == 'en_curso') ||
          (resource.data.status == 'en_curso' && request.resource.data.status == 'entregado' &&
            pagoValidoAlEntregar() && codigoEntregaValido(envioId))) &&
        request.resource.data.repartidorAsignadoId == resource.data.repartidorAsignadoId &&
        request.resource.data.ofertaAceptadaId == resource.data.ofertaAceptadaId &&
        envioCamposFijosSinCambio();

      // Un Admin marca como verificado el comprobante QR de un envío ya
      // entregado (Sprint 6.1) — único campo de envios que el rol admin
      // puede escribir. Sin flujo de "rechazar", mismo criterio que la
      // aprobación KYC del Sprint 5.1 (solo aprobar, sin ampliar alcance).
      allow update: if isAdmin() &&
        resource.data.status == 'entregado' &&
        resource.data.metodoPago == 'qr' &&
        request.resource.data.pagoVerificado == true &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.metodoPago == resource.data.metodoPago &&
        request.resource.data.comprobanteUrl == resource.data.comprobanteUrl &&
        request.resource.data.repartidorAsignadoId == resource.data.repartidorAsignadoId &&
        request.resource.data.ofertaAceptadaId == resource.data.ofertaAceptadaId &&
        envioCamposFijosSinCambio();

      // El repartidor asignado actualiza su posición en vivo mientras el
      // viaje está en curso (Sprint 4.1b) — no cambia status ni ningún
      // otro campo.
      allow update: if isSignedIn() &&
        resource.data.repartidorAsignadoId == request.auth.uid &&
        resource.data.status == 'en_curso' &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.repartidorPosicionActual is latlng &&
        request.resource.data.repartidorAsignadoId == resource.data.repartidorAsignadoId &&
        request.resource.data.ofertaAceptadaId == resource.data.ofertaAceptadaId &&
        envioCamposFijosSinCambio();

      allow delete: if false;

      match /ofertas/{ofertaId} {
        allow read: if isSignedIn();

        allow create: if isVerifiedRepartidor() &&
          request.auth.uid == request.resource.data.repartidorId &&
          request.resource.data.status == 'pendiente' &&
          request.resource.data.montoOfertadoCentavos is int &&
          request.resource.data.montoOfertadoCentavos > 0;

        // Solo el cliente dueño del envío padre puede marcar su propuesta
        // como aceptada (parte de EnviosRepository.aceptarOferta), sin
        // tocar monto ni repartidor.
        allow update: if isSignedIn() &&
          get(/databases/$(database)/documents/envios/$(envioId)).data.clienteId == request.auth.uid &&
          resource.data.status == 'pendiente' &&
          request.resource.data.status == 'aceptada' &&
          request.resource.data.repartidorId == resource.data.repartidorId &&
          request.resource.data.montoOfertadoCentavos == resource.data.montoOfertadoCentavos;

        // Mismo dueño, para rechazar en vez de aceptar (Sprint 13) — no
        // cambia el status del envío padre, solo cierra esta propuesta.
        allow update: if isSignedIn() &&
          get(/databases/$(database)/documents/envios/$(envioId)).data.clienteId == request.auth.uid &&
          resource.data.status == 'pendiente' &&
          request.resource.data.status == 'rechazada' &&
          request.resource.data.repartidorId == resource.data.repartidorId &&
          request.resource.data.montoOfertadoCentavos == resource.data.montoOfertadoCentavos;

        allow delete: if false;
      }

      // Calificación cruzada (Sprint 6.1). El ID del documento es el uid
      // del autor: una segunda escritura del mismo usuario es "update", no
      // "create", y no hay regla de allow update — eso previene una
      // segunda calificación sin necesitar una transacción.
      match /calificaciones/{autorId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn() &&
          autorId == request.auth.uid &&
          request.resource.data.autorId == request.auth.uid &&
          request.resource.data.estrellas is int &&
          request.resource.data.estrellas >= 1 &&
          request.resource.data.estrellas <= 5 &&
          get(/databases/$(database)/documents/envios/$(envioId)).data.status == 'entregado' &&
          (
            (get(/databases/$(database)/documents/envios/$(envioId)).data.clienteId == request.auth.uid &&
              request.resource.data.paraId ==
                get(/databases/$(database)/documents/envios/$(envioId)).data.repartidorAsignadoId) ||
            (get(/databases/$(database)/documents/envios/$(envioId)).data.repartidorAsignadoId == request.auth.uid &&
              request.resource.data.paraId ==
                get(/databases/$(database)/documents/envios/$(envioId)).data.clienteId)
          );

        allow update: if false;
        allow delete: if false;
      }

      // Historial de posición (Sprint 8.3) — sin UI de disputas todavía
      // (queda fuera de este roadmap), pero el dato ya queda protegido
      // desde ahora: solo el repartidor asignado, mientras el viaje sigue
      // en curso, puede agregar puntos; nadie los edita ni borra; solo
      // Admin puede leerlos (no hay una razón operativa para que Cliente o
      // Repartidor los lean directo, ya ven la posición actual en
      // `repartidorPosicionActual`).
      match /posiciones/{posId} {
        allow read: if isAdmin();

        allow create: if isSignedIn() &&
          get(/databases/$(database)/documents/envios/$(envioId)).data.repartidorAsignadoId == request.auth.uid &&
          get(/databases/$(database)/documents/envios/$(envioId)).data.status == 'en_curso' &&
          request.resource.data.posicion is latlng;

        allow update: if false;
        allow delete: if false;
      }

      // Código de entrega (Sprint 8.2), separado del documento padre a
      // propósito — ver `codigoEntregaValido()` más arriba para el porqué.
      // Solo el cliente dueño (o Admin, para una futura auditoría) puede
      // leerlo; el repartidor nunca tiene permiso de lectura acá, solo la
      // regla de transición a `entregado` lo compara server-side.
      match /privado/{docId} {
        allow read: if isAdmin() ||
          (isSignedIn() && resource.data.clienteId == request.auth.uid);

        allow create: if isVerifiedCliente() &&
          request.resource.data.clienteId == request.auth.uid &&
          request.resource.data.codigoEntrega is string &&
          request.resource.data.codigoEntrega.size() == 4 &&
          request.resource.data.keys().hasOnly(['codigoEntrega', 'clienteId']);

        allow update: if false;
        allow delete: if false;
      }
    }

    // Regla aparte para consultas de collection group (sprint extra, bug
    // real reportado: "Mis calificaciones" nunca cargaba). La regla
    // anidada de más arriba (match /envios/{envioId} { match
    // /calificaciones/{autorId} {...} }) solo cubre lecturas directas de
    // un envío puntual o de su subcolección — Firestore NO la extiende
    // automáticamente a un `collectionGroup('calificaciones')` sobre
    // TODOS los envíos, que es justo lo que usa
    // UsersRepository.streamMisCalificaciones. Sin esta regla aparte con
    // wildcard recursivo, esa consulta siempre devolvía
    // PERMISSION_DENIED para cualquier usuario real (el diagnóstico
    // anterior con el Admin SDK no lo detectó porque el Admin SDK
    // bypassa las Rules por completo).
    match /{path=**}/calificaciones/{autorId} {
      allow read: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
