rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    // role e isVerified solo los escribe la Cloud Function (Admin SDK),
    // que no pasa por estas reglas. El cliente puede crear su doc inicial
    // pero nunca fijar esos dos campos por su cuenta.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) &&
        !("role" in request.resource.data) &&
        !("isVerified" in request.resource.data);
      allow update: if isOwner(uid) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.isVerified == resource.data.isVerified;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
