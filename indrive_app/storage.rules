rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    // Documentos de KYC (ej. foto de Cedula de Identidad): solo el dueno
    // puede subir/leer los suyos; admin puede leer para revision manual.
    match /kyc/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Comprobante de pago QR (Sprint 6.1): el uid del repartidor va en el
    // path (comprobantes/{envioId}/{repartidorId}/...), mismo patrón que
    // /kyc/{uid}/ — evita depender de un firestore.get() cruzado para la
    // escritura (que en la práctica devolvía "unauthorized" sin más
    // detalle). Para la lectura del Cliente sí hace falta cruzar a
    // Firestore, porque su uid no está en el path.
    match /comprobantes/{envioId}/{repartidorId}/{allPaths=**} {
      allow read: if isOwner(repartidorId) ||
        isAdmin() ||
        (isSignedIn() &&
          firestore.get(/databases/(default)/documents/envios/$(envioId)).data.clienteId == request.auth.uid);
      allow write: if isOwner(repartidorId) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
