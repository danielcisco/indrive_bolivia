rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    // Documentos de KYC (ej. foto de Cedula de Identidad): solo el dueno
    // puede subir/leer los suyos; admin puede leer para revision manual.
    match /kyc/{uid}/{allPaths=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Comprobante de pago QR (Sprint 6.1): el "dueño" depende de un envío
    // en Firestore, no de un uid fijo como /kyc/ — de ahí el firestore.get()
    // cruzado entre Storage y Firestore (soportado en Rules v2).
    match /comprobantes/{envioId}/{allPaths=**} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        firestore.get(/databases/(default)/documents/envios/$(envioId)).data.repartidorAsignadoId == request.auth.uid ||
        firestore.get(/databases/(default)/documents/envios/$(envioId)).data.clienteId == request.auth.uid
      );
      allow write: if isSignedIn() &&
        firestore.get(/databases/(default)/documents/envios/$(envioId)).data.repartidorAsignadoId == request.auth.uid &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
